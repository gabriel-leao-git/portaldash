# Copie para .env.local e preencha. Nunca versione valores reais.
# Nenhuma variável usa o prefixo NEXT_PUBLIC_: credenciais ficam só no servidor.

# Site e API pública. Em produção, prefira um papel somente leitura
# (docs/architecture.md, "Banco de dados em produção"); nunca a credencial de escrita.
DATABASE_URL=postgresql://USUARIO:SENHA@HOST:5432/portaldash

# Ingestão e migrations (escrita e DDL). Só no serviço de ingestão; nunca no web.
# `pnpm db:migrate` exige esta variável. A ingestão cai para DATABASE_URL se vazia.
INGEST_DATABASE_URL=postgresql://USUARIO:SENHA@HOST:5432/portaldash

# Testes: banco descartável externo (usado na CI). Se vazio, os testes sobem
# um PostgreSQL embutido.
TEST_DATABASE_URL=

# Desenvolvimento local sem Docker: `pnpm db:dev` sobe um PostgreSQL em
# postgresql://postgres:portaldash@127.0.0.1:54329/portaldash (porta ajustável).
DEV_DB_PORT=54329
