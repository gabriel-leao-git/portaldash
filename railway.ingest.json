{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "RAILPACK",
    "buildCommand": "pnpm build"
  },
  "deploy": {
    "preDeployCommand": ["pnpm db:migrate"],
    "startCommand": "pnpm ingest --origem=cron",
    "cronSchedule": "0 9 * * *",
    "restartPolicyType": "NEVER"
  }
}
