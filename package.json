{
  "name": "portaldash",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Portal público e crítico sobre gastos públicos brasileiros.",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=24.21.0 <25"
  },
  "packageManager": "pnpm@11.28.2",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint --max-warnings=0",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "check": "pnpm lint && pnpm typecheck && pnpm test && pnpm build",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node --env-file-if-exists=.env.local scripts/migrate.ts",
    "db:dev": "node --env-file-if-exists=.env.local scripts/dev-db.ts",
    "ingest": "node --env-file-if-exists=.env.local scripts/ingest.ts"
  },
  "dependencies": {
    "drizzle-orm": "0.45.3",
    "next": "16.3.8",
    "pg": "8.23.1",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@types/node": "24.19.0",
    "@types/pg": "^8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.2.3",
    "drizzle-kit": "0.31.11",
    "embedded-postgres": "18.4.0-beta.17",
    "eslint": "10.11.0",
    "eslint-config-next": "16.3.8",
    "typescript": "6.0.3",
    "vite": "8.3.1",
    "vitest": "5.0.3"
  }
}
